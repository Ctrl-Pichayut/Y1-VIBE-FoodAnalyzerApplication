# Mobile API URL configuration
# Leave commented out to use the production cloud backend (Render) by default:
# EXPO_PUBLIC_API_URL=https://foodanalyzer-api-t9i6.onrender.com

# For local development against local FastAPI backend (http://<host>:8000):
# EXPO_PUBLIC_USE_LOCAL=1
# Or specify explicit local backend IP / URL:
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
