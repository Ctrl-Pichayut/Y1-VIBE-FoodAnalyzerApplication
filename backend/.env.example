# Google Gemini API key for the hybrid food recognition layer.
# Get one at https://aistudio.google.com/apikey
# Leave unset (or comment out) to run in YOLO-only mode (recognition.mode: "yolo").
GEMINI_API_KEY=

# Supabase PostgreSQL connection URL (production).
# Get it from: Supabase Dashboard → Project Settings → Database → Connection string
# Leave unset for local development (falls back to SQLite via config.yaml).
DATABASE_URL=
